{
  "$schema": "https://unpkg.com/@changesets/config@4.0.0/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    {
      "repo": "chiefGui/stackyard",
      "disableThanks": true,
      "template": "- {summary} {ref}"
    }
  ],
  "commit": false,
  "fixed": [],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "changedFilePatterns": ["**"],
  "format": "oxfmt",
  "privatePackages": {
    "version": false,
    "tag": false
  },
  "updateInternalDependencies": "patch",
  "ignore": []
}
