{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "error",
    "suspicious": "error"
  },
  "plugins": ["import", "jsx-a11y", "oxc", "react", "typescript", "unicorn"],
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["apps/dashboard-web/src/**/*.ts", "apps/dashboard-web/src/**/*.tsx"],
      "jsPlugins": [{ "name": "stylex", "specifier": "@stylexjs/eslint-plugin" }],
      "rules": {
        "stylex/enforce-extension": "error",
        "stylex/no-conflicting-props": "error",
        "stylex/no-legacy-contextual-styles": "error",
        "stylex/no-lookahead-selectors": "error",
        "stylex/no-nonstandard-styles": "error",
        "stylex/no-unused": "error",
        "stylex/valid-styles": "error"
      }
    },
    {
      "files": ["packages/sdk/src/**/*.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["packages/sdk/src/project.ts"],
      "rules": {
        "unicorn/no-array-sort": "off"
      }
    },
    {
      "files": [
        "packages/project-loader/src/discovery.ts",
        "packages/project-loader/src/process-output.ts"
      ],
      "rules": {
        "eslint/no-await-in-loop": "off"
      }
    },
    {
      "files": [
        "apps/server/src/main.ts",
        "apps/web/src/main.ts",
        "packages/control-plane/src/index.ts"
      ],
      "rules": {
        "unicorn/require-module-specifiers": "off"
      }
    }
  ],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "ignorePatterns": [
    "apps/dashboard-web/src/routeTree.gen.ts",
    "coverage/**",
    "dist/**",
    "node_modules/**"
  ]
}
