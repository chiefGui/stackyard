{
  "name": "stackyard",
  "private": true,
  "bin": {
    "stackyard": "./src/main.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build ./src/main.ts --outdir ./dist --target bun",
    "typecheck": "tsc -p ./tsconfig.json"
