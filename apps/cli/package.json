{
  "name": "stackyard",
  "version": "0.0.0",
  "bin": {
    "stackyard": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown && bun build ./src/main.ts --outfile ./dist/cli.js --target bun",
    "pack:local": "bun pm pack --destination ../../artifacts",
    "prepack": "bun run build",
    "typecheck": "tsc -p ./tsconfig.json"
  },
  "devDependencies": {
    "@stackyard/diagnostics": "0.0.0",
    "@stackyard/project-loader": "0.0.0",
    "@stackyard/sdk": "0.0.0",
    "@types/bun": "catalog:",
    "tsdown": "0.22.14",
    "typescript": "catalog:"
  }
}
