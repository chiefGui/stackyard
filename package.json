{
  "name": "stackyard-workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "@types/bun": "1.4.0",
      "typescript": "7.0.2"
    }
  },
  "scripts": {
    "bench": "bun run ./benchmarks/project-definition.ts",
    "build": "bun run --workspaces --if-present build",
    "typecheck": "bun run typecheck:packages && tsc -p ./tsconfig.json",
    "typecheck:packages": "bun run --workspaces --if-present typecheck",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage && bun run build"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "mitata": "1.0.34",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.0"
}
