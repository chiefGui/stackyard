{
  "name": "stackyard-workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "examples/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.0.0-rc.112",
      "@stylexjs/stylex": "0.19.0",
      "@stylexjs/unplugin": "0.19.0",
      "@tanstack/react-query": "5.102.8",
      "@tanstack/react-router": "1.170.32",
      "@tanstack/router-plugin": "1.168.35",
      "@types/bun": "1.4.0",
      "@types/node": "26.4.0",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.5",
      "@vitejs/plugin-react": "6.1.1",
      "effect": "4.0.0-rc.112",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "unplugin": "2.3.11",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
      "vite-plus": "0.3.0",
      "typescript": "7.0.2"
    }
  },
  "scripts": {
    "bench": "bun run ./benchmarks/project-definition.ts",
    "bench:resource-logs": "bun run ./benchmarks/resource-logs.ts",
    "build": "bun run --workspaces --if-present build",
    "changeset": "changeset",
    "dev": "bun --watch --no-clear-screen ./scripts/dev.ts",
    "pack:local": "bun run --filter stackyard pack:local",
    "typecheck": "bun run typecheck:packages && tsc -p ./tsconfig.json",
    "typecheck:packages": "bun run --workspaces --if-present typecheck",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "validate:changesets": "bun scripts/validate-changesets.ts",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "stackyard": "bun ./apps/cli/src/main.ts",
    "version-packages": "changeset version && bun update stackyard --lockfile-only",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage && bun run build"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@stylexjs/eslint-plugin": "0.19.0",
    "@types/bun": "catalog:",
    "effect": "catalog:",
    "mitata": "1.0.34",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "stackyard": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.4.0"
}
